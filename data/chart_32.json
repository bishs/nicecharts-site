  "explanation": {
    "summary": "Each summer (June to August), how hot the US was and how much electricity an average home used. In 16 of 17 years, both went up or down together.",
    "methodology": "Heat: NOAA cooling degree days for the contiguous US, summed over June to August. A cooling degree day counts how far a day's average temperature is above 65\u00b0F, so it measures how much cooling homes need. Power: EIA residential electricity sales divided by the number of residential customers, summed over June to August. Using use per home removes the effect of more homes being built. Correlation of the year-to-year changes: 0.96 (1.0 would be a perfect match). EIA customer counts start in 2008.",
    "key_findings": [
      {
        "date": "2009-07-01",
        "title": "Mildest summer: 2009",
        "description": "The average home used 3,112 kWh from June to August.",
        "significance": "low point",
        "normalized_time": 0.0588
      },
      {
        "date": "2011-07-01",
        "title": "Hottest summer: 2011",
        "description": "The average home used 3,436 kWh from June to August.",
        "significance": "high point",
        "normalized_time": 0.1765
      }
    ]
